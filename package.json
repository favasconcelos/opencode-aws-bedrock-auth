{
  "name": "opencode-aws-bedrock-auth",
  "version": "0.2.0",
  "description": "OpenCode plugin that automatically refreshes AWS Bedrock SSO sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/",
    "check": "npm run typecheck && npm run lint && npm run fmt:check"
  },
  "keywords": [
    "opencode",
    "plugin",
    "aws",
    "bedrock",
    "sso",
    "auth"
  ],
  "author": "Felipe Vasconcelos <f@avasconcelos.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favasconcelos/opencode-aws-bedrock-auth.git"
  },
  "homepage": "https://github.com/favasconcelos/opencode-aws-bedrock-auth#readme",
  "bugs": {
    "url": "https://github.com/favasconcelos/opencode-aws-bedrock-auth/issues"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.28",
    "@types/node": "26.1.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3"
  }
}
